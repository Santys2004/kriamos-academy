APP_NAME="Kriamos BioGestión ICA"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://biogestion.kriamos.com.co

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kriamos_biogestion_ica
DB_USERNAME=kriamos_user
DB_PASSWORD=CAMBIAR_PASSWORD_SEGURO

CORPORATE_DOMAIN=kriamos.com.co
SESSION_LIFETIME=60
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

MAIL_HOST=smtp.kriamos.com.co
MAIL_PORT=587
MAIL_USERNAME=notificaciones@kriamos.com.co
MAIL_PASSWORD=CAMBIAR_PASSWORD_CORREO
MAIL_FROM_ADDRESS=notificaciones@kriamos.com.co
MAIL_FROM_NAME="Kriamos BioGestión ICA"

ALERT_DAYS_FORMAT_DELAY=3
ALERT_CERT_DAYS_90=90
ALERT_CERT_DAYS_60=60
ALERT_CERT_DAYS_30=30
ALERT_CERT_DAYS_15=15

BACKUP_PATH=/var/backups/kriamos-biogestion
LOG_RETENTION_DAYS=180
REQUIRE_HTTPS=true
SECURITY_HEADERS=true
